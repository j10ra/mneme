# Postgres / Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
MNEME_READER_DATABASE_URL=

# LLM provider (extraction). Today only "local" is wired (OpenAI-compatible
# endpoint behind a Caddy/Cloudflare-tunnel proxy — typically Ollama or vLLM).
# Add new providers under packages/server/src/llm/<name>.ts and register them
# in packages/server/src/llm/index.ts.
LLM_PROVIDER=local
LLM_URL=                                  # e.g. https://mneme-ai.lens-engine.com
LLM_BEARER=                               # 32+ char shared secret enforced by the proxy
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TIMEOUT_MS=600000                     # 10 min — local 7B can take 60-180s per call

# Embedder provider. Today only "local" is wired (HuggingFace TEI shape).
# bge-large-en-v1.5 is 1024-dim native; matches the memories.embedding column.
EMBEDDER_PROVIDER=local
EMBEDDER_URL=                             # usually same host as LLM_URL
EMBEDDER_BEARER=                          # usually same as LLM_BEARER
EMBEDDER_MODEL=BAAI/bge-large-en-v1.5
EMBEDDER_TIMEOUT_MS=30000

# Server
PORT=3100
NODE_ENV=development
