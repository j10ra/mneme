# Postgres / Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
MNEME_READER_DATABASE_URL=

# LLM — local provider. OpenAI-compatible endpoint; today the
# compute.jalipalo.dev CF Worker fronting Ollama on inference-vm /
# homelab-vm. Used as the embed path (always) and the LLM fallback when
# OpenRouter is missing or its breaker is open.
LLM_URL=                                  # e.g. https://compute.jalipalo.dev
LLM_BEARER=                               # 32+ char shared secret enforced by the proxy
LLM_MODEL=mneme-llm                       # Ollama Modelfile alias on each VM
LLM_TIMEOUT_MS=240000                     # 4 min — covers warm 7B on chunky prompts

# LLM — OpenRouter (cloud, primary path for extract + dream when set).
# Picker (packages/server/src/llm/pick.ts) auto-prefers OpenRouter when
# OPENROUTER_API_KEY is present and its breaker is closed; falls back to
# the local provider above on errors. Two model envs because extract is
# a hot path (cheap, structured-JSON) while dream is a daily synthesis
# pass (worth a more capable model).
OPENROUTER_API_KEY=                       # sk-or-... — leave blank to disable cloud path
OPENROUTER_EXTRACT_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_DREAM_MODEL=anthropic/claude-sonnet-4
OPENROUTER_TIMEOUT_MS=120000

# Override picker. Empty/unset = auto. "local" or "openrouter" = force.
# Use "local" temporarily to disable the cloud path without removing the
# API key (e.g. during incident response or while smoke-testing).
LLM_PROVIDER_FORCE=

# Embedder provider. Today only "local" is wired (HuggingFace TEI shape).
# bge-large-en-v1.5 is 1024-dim native; matches the memories.embedding column.
EMBEDDER_PROVIDER=local
EMBEDDER_URL=                             # usually same host as LLM_URL
EMBEDDER_BEARER=                          # usually same as LLM_BEARER
EMBEDDER_MODEL=BAAI/bge-large-en-v1.5
EMBEDDER_TIMEOUT_MS=30000

# Server
PORT=3100
NODE_ENV=development

# Worker toggles
# Digest = the cross-cluster consolidator (#30). Third worker in the
# brain trio (nap → dream → digest). When enabled, runs weekly: merges
# clusters that turned out to be the same topic + writes cross-cluster
# supersedes the daemon's per-cycle dream can't see. Sonnet-grade via
# openrouter; ~5-10 calls per cycle at current corpus scale.
# 0 = off (default; safe — the worker isn't even registered with the
#         scheduler, so /mneme:status stays clean and no Sonnet calls
#         fire from this server)
# 1 = on  (registered weekly; first cycle fires once shortly after
#         deploy because next_run_at is set to now() on fresh registration)
MNEME_DIGEST_ENABLED=0
