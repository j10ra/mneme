{
  "name": "mneme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "skills": [
      "packages/plugin/skills"
    ],
    "extensions": [
      "packages/plugin/src/pi/register.ts",
      "packages/plugin/src/pi/capture.ts",
      "packages/plugin/src/pi/commands.ts"
    ]
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun --hot packages/server/src/index.ts",
    "dev:watch": "bun --watch packages/server/src/index.ts",
    "start": "bun packages/server/src/index.ts",
    "migrate": "bun scripts/migrate.ts",
    "migrate:dry": "bun scripts/migrate.ts --dry-run",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "lint:style": "eslint .",
    "lint:style:fix": "eslint . --fix",
    "build:plugin-scrub": "bun build packages/shared/src/scrub.ts --outfile packages/plugin/src/core/scrub.ts --format esm --target bun --banner '// @ts-nocheck'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "postgres": "^3.4.5",
    "typescript": "^5.6.3"
  }
}
