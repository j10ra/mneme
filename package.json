{
  "name": "mneme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --hot packages/server/src/index.ts",
    "dev:watch": "bun --watch packages/server/src/index.ts",
    "start": "bun packages/server/src/index.ts",
    "migrate": "bun scripts/migrate.ts",
    "migrate:dry": "bun scripts/migrate.ts --dry-run",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "postgres": "^3.4.5",
    "typescript": "^5.6.3"
  }
}
