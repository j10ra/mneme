#!/usr/bin/env bash
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc|css)$' || true)

if [ -n "$staged" ]; then
  # Format staged files in place; Biome's --staged restricts to indexed regions.
  bunx --bun biome check --staged --write --no-errors-on-unmatched

  # Blank-line padding (functions/const-groups/returns/blocks) — rules Biome
  # cannot express, owned by ESLint. Autofix-only; never blocks the commit.
  # Note: --fix rewrites whole files, so prefer staging files completely.
  js_staged=$(echo "$staged" | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)
  if [ -n "$js_staged" ]; then
    echo "$js_staged" | xargs -r bunx eslint --fix >/dev/null 2>&1 || true
  fi

  # Re-stage any files Biome or ESLint rewrote so the commit captures the result.
  echo "$staged" | xargs -r git add --
fi

# Version-pill consistency: when plugin version is bumped, the dashboard bundle
# must contain that version (it's baked in at build time via __APP_VERSION__).
# Forgetting to rebuild ships a dashboard that shows the previous version.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^packages/plugin/(package\.json|\.claude-plugin/plugin\.json)$'; then
  plugin_ver=$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' packages/plugin/package.json | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
  bundle=packages/plugin/dashboard/dist/bundle.js
  if [ -z "$plugin_ver" ]; then
    echo "pre-commit: could not parse plugin version from packages/plugin/package.json" >&2
    exit 1
  fi
  if [ ! -f "$bundle" ] || ! grep -q "\"$plugin_ver\"" "$bundle"; then
    echo "" >&2
    echo "pre-commit: dashboard bundle does not contain plugin version \"$plugin_ver\"." >&2
    echo "            the version pill will be stale on every machine that updates." >&2
    echo "" >&2
    echo "  fix:      cd packages/plugin/dashboard && bun run build" >&2
    echo "            git add packages/plugin/dashboard/dist" >&2
    echo "" >&2
    exit 1
  fi
fi

# Plugin-distribution consistency: any change to code that ships in the
# plugin must come with a plugin version bump, otherwise /plugin update
# on user machines won't pull the new code.
#
# Two flavours:
#   - packages/(daemon|core|shared)/src/  → bundled into daemon.js;
#     must also re-stage daemon.js
#   - packages/plugin/scripts/            → ships as source; just need
#     the version bump
bundled_src=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^packages/(daemon|core|shared)/src/' || true)
plugin_src=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^packages/plugin/scripts/' || true)

if [ -n "$bundled_src" ] || [ -n "$plugin_src" ]; then
  if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^packages/plugin/(package\.json|\.claude-plugin/plugin\.json)$'; then
    echo "" >&2
    echo "pre-commit: plugin source changed but plugin version is not bumped." >&2
    echo "            /plugin update will not pull the new code." >&2
    echo "" >&2
    echo "  files:    $(echo "$bundled_src $plugin_src" | tr ' ' '\n' | head -3 | tr '\n' ' ')" >&2
    echo "" >&2
    echo "  fix:      bump packages/plugin/{.claude-plugin/plugin.json,package.json}" >&2
    if [ -n "$bundled_src" ]; then
      echo "            bun scripts/build-plugin.ts" >&2
    fi
    echo "            cd packages/plugin/dashboard && bun run build" >&2
    echo "            git add packages/plugin/{.claude-plugin/plugin.json,package.json,dashboard/dist}" >&2
    if [ -n "$bundled_src" ]; then
      echo "            git add packages/plugin/daemon.js packages/plugin/embed-worker.js" >&2
    fi
    echo "" >&2
    exit 1
  fi
  # Bundled source changed AND version bumped — daemon.js must be staged too.
  if [ -n "$bundled_src" ] && ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^packages/plugin/daemon\.js$'; then
    echo "" >&2
    echo "pre-commit: bundled source changed and plugin version bumped, but daemon.js is not staged." >&2
    echo "            the bundle on disk is stale; rebuild before committing." >&2
    echo "" >&2
    echo "  files:    $(echo "$bundled_src" | head -3 | tr '\n' ' ')" >&2
    echo "" >&2
    echo "  fix:      bun scripts/build-plugin.ts" >&2
    echo "            git add packages/plugin/daemon.js packages/plugin/embed-worker.js" >&2
    echo "" >&2
    exit 1
  fi
fi
